// GENERATED BY CHATGPT

PRINTLN "=== Kalkulačka 2x2 Matíc ==="

// Definujeme dve 2x2 matice
A = [0,0,0,0]
B = [0,0,0,0]
C = [0,0,0,0] // výsledok

// Nahratie matice A
PRINTLN "Zadaj prvky matice A:"
FOR i = 0 TO 3 DO
  PRINTLN "A[" + TO_STRING i + "] = "
  A[i] = TO_INT INPUT
END

// Nahratie matice B
PRINTLN "Zadaj prvky matice B:"
FOR i = 0 TO 3 DO
  PRINTLN "B[" + TO_STRING i + "] = "
  B[i] = TO_INT INPUT
END

// Sčítanie matíc
FOR i = 0 TO 3 DO
  C[i] = A[i] + B[i]
END

// Výpis výsledku
PRINTLN "Výsledok sčítania matíc A + B:"
PRINTLN TO_STRING C[0] + " " + TO_STRING C[1]
PRINTLN TO_STRING C[2] + " " + TO_STRING C[3]

// Násobenie matíc (2x2)
C[0] = A[0]*B[0] + A[1]*B[2]
C[1] = A[0]*B[1] + A[1]*B[3]
C[2] = A[2]*B[0] + A[3]*B[2]
C[3] = A[2]*B[1] + A[3]*B[3]

PRINTLN "Výsledok násobenia matíc A * B:"
PRINTLN TO_STRING C[0] + " " + TO_STRING C[1]
PRINTLN TO_STRING C[2] + " " + TO_STRING C[3]

