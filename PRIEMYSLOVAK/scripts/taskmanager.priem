// GENERATED BY CHATGPT

PRINTLN "=== TASK MANAGER ==="

// Fixná kapacita poľa
max_tasks = 10
tasks = ["", "", "", "", "", "", "", "", "", ""]

running = true

WHILE (running) DO

  PRINTLN ""
  PRINTLN "1 - Pridať úlohu"
  PRINTLN "2 - Zobraziť úlohy"
  PRINTLN "3 - Zmazať úlohu"
  PRINTLN "4 - Koniec"

  choice = INPUT

  // ==============================
  // PRIDAŤ ÚLOHU
  // ==============================
  IF (choice == "1") THEN

    PRINTLN "Zadaj názov úlohy:"
    new_task = INPUT

    // Hľadáme prvý prázdny slot ""
    added = false

    FOR i = 0 TO max_tasks - 1 DO

      // Prázdny string znamená voľné miesto
      IF (tasks[i] == "") THEN
        tasks[i] = new_task
        added = true
        BREAK
      END

    END

    IF (added) THEN
      PRINTLN "Úloha pridaná."
    END

    ELSE
      PRINTLN "Zoznam je plný!"
    END

  END

  // ==============================
  // ZOBRAZIŤ ÚLOHY
  // ==============================
  ELIF (choice == "2") THEN

    PRINTLN "Zoznam úloh:"

    empty = true

    FOR i = 0 TO max_tasks - 1 DO

      // Vypíšeme len neprázdne položky
      IF (tasks[i] ~= "") THEN
        PRINTLN TO_STRING i + ": " + tasks[i]
        empty = false
      END

    END

    IF (empty) THEN
      PRINTLN "(žiadne úlohy)"
    END

  END

  // ==============================
  // ZMAZAŤ ÚLOHU (SOFT DELETE)
// ==============================
  ELIF (choice == "3") THEN

    PRINTLN "Zadaj index úlohy na zmazanie:"
    idx = TO_INT INPUT

    // Kontrola rozsahu
    IF (idx < 0 OR idx >= max_tasks) THEN
      PRINTLN "Neplatný index."
    END

    ELIF (tasks[idx] == "") THEN
      PRINTLN "Na tomto indexe nie je žiadna úloha."
    END

    ELSE
      // Soft delete – zmena na prázdny string
      tasks[idx] = ""
      PRINTLN "Úloha zmazaná."
    END

  END

  // ==============================
  // KONIEC
  // ==============================
  ELSE
    running = false
  END

END

PRINTLN "Program ukončený."

