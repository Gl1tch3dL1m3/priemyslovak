// GENERATED BY CHATGPT

PRINTLN "=== MINI RPG ==="
PRINTLN "Zadaj svoje meno:"
name = INPUT

hp = 20
gold = 0
running = true

enemies = ["Goblin", "Kostlivec", "Vlk"]
enemy_count = 3

WHILE (running) DO

  PRINTLN ""
  PRINTLN "Hráč: " + name
  PRINTLN "HP: " + TO_STRING hp + " | Zlato: " + TO_STRING gold
  PRINTLN "1 - Boj"
  PRINTLN "2 - Oddych"
  PRINTLN "3 - Koniec"

  choice = INPUT

  IF (choice == "1") THEN

    idx = TO_INT (RANDOM * (enemy_count-1))
    enemy = enemies[idx]

    enemy_hp = TO_INT (RANDOM * 10 + 5)

    PRINTLN "Narazil si na nepriateľa: " + enemy
    PRINTLN "Jeho HP: " + TO_STRING enemy_hp

    WHILE (enemy_hp > 0 AND hp > 0) DO
      dmg = TO_INT (RANDOM * 6 + 1)
      enemy_hp = enemy_hp - dmg
      PRINTLN "Zasiahol si za " + TO_STRING dmg

      IF (enemy_hp <= 0) THEN
        BREAK
      END

      edmg = TO_INT (RANDOM * 5 + 1)
      hp = hp - edmg
      PRINTLN "Nepriateľ ťa zasiahol za " + TO_STRING edmg
    END

    IF (hp <= 0) THEN
      PRINTLN "Zomrel si!"
      running = false
    END

    ELSE
      reward = TO_INT (RANDOM * 10 + 5)
      gold = gold + reward
      PRINTLN "Vyhral si boj a získal " + TO_STRING reward + " zlata"
    END

  END

  ELIF (choice == "2") THEN
    heal = TO_INT (RANDOM * 5 + 2)
    hp = hp + heal
    PRINTLN "Oddychuješ, obnovil si " + TO_STRING heal + " HP"
  END

  ELSE
    PRINTLN "Koniec hry."
    running = false
  END

END

PRINTLN "Ďakujem za hru!"

